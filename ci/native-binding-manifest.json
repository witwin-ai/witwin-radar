  "no_backward": {
    "cfar_order_statistic": "Detection is a discrete selection below the R-ADR-018 differentiability wall; witwin/radar/processing/detection.py refuses a differentiable map before this operator runs.",
    "dbscan_labels": "Cluster labels are discrete; witwin/radar/processing/detection.py refuses a differentiable point cloud before this operator runs.",
    "fluctuation_factor": "The Swerling factor is a counter-based draw from a host key and has no differentiable input; witwin/radar/scattering.py multiplies the response by it, so a derivative of the response reaches the strength through that product.",
    "frontend_baseband": "The kernel writes the additive DC offset and flicker term; witwin/radar/frontend.py adds it to the signal, so the identity derivative is carried by that addition and the family needs no companion.",
    "frontend_quantize": "The ADC sits below the R-ADR-018 differentiability wall: quantization is a discrete choice, and witwin/radar/frontend.py refuses a differentiable input before this operator runs.",
    "oscillator_phase": "Oscillator phase (white-FM, flicker-FM and floor regions) is nowhere differentiable in time; witwin/radar/frontend.py refuses a differentiable timestamp or path delay before this operator runs.",
    "path_events": "An event is a discrete change of a row's existence and has no derivative; witwin/radar/events.py passes detached payloads and the log is published as host diagnostics, never into a differentiable result."
  },
